# Live responses include X-Frame-Options on every URL. Cloudflare Pages does not
# send this header by itself. Pages already sends Access-Control-Allow-Origin,
# Referrer-Policy, and X-Content-Type-Options, so those are not repeated here.
/*
  X-Frame-Options: SAMEORIGIN

# Every file under /images/ is served with a one-year immutable cache.
# Detach first so this does not get joined with Pages' default
# "public, max-age=0, must-revalidate".
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The only stylesheet. Live cache is one day, without must-revalidate.
/site.css
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Root files that are not HTML. Live cache is four hours.
/favicon.png
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate

/og-image.jpg
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=14400, must-revalidate
